# Copy to .env (or set in your environment). Everything is optional.

# Where Errand listens. Keep 127.0.0.1; to use Errand on your phone, turn on Settings → Use on your phone.
ERRAND_HOST=127.0.0.1
ERRAND_PORT=4747
# Port for phone access (defaults to ERRAND_PORT + 1).
# ERRAND_PHONE_PORT=4748

# Where data lives (database, encrypted vault, files, browser profile).
ERRAND_DATA_DIR=./data

# Required if ERRAND_HOST is not 127.0.0.1: protects the app with a password.
# ERRAND_PASSWORD=

# Extra host names allowed to reach the server (comma separated), e.g. when behind a domain.
# ERRAND_ALLOWED_HOSTS=errand.example.com

# Public URL used for OAuth redirects (Google sign-in). Defaults to http://localhost:<port>.
# ERRAND_PUBLIC_URL=https://errand.example.com

# Browser agent. Defaults to Edge on Windows, Chrome elsewhere.
# ERRAND_BROWSER_CHANNEL=chrome        # msedge | chrome | chromium | custom | remote
# ERRAND_BROWSER_PATH=/usr/bin/chromium
# ERRAND_HEADLESS=1
# ERRAND_CDP_URL=wss://your-remote-browser
